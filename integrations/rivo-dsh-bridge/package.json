{
  "name": "rivo-dsh-bridge",
  "version": "0.2.1",
  "description": "Connect the Rivo Relay mobile app to this DeepSeek Harness Host.",
  "type": "module",
  "main": "bundle.mjs",
  "exports": {
    ".": "./bundle.mjs",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": ["bundle.mjs", "index.mjs", "client.js", "cordis.patch.yml", "locale/*.json"],
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {"platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager"]}
  },
  "scripts": {"test": "node --test"},
  "engines": {"node": ">=22", "dsh": "0.2.2-rc.5"},
  "license": "MIT"
}
